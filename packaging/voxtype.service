[Unit]
Description=VoxType local voice dictation
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/voxtype daemon
Environment=VOXTYPE_MODEL=/usr/share/voxtype/models/ggml-base.en.bin
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
