[Desktop Entry]
Type=Application
Version=1.0
Name=VoxType
GenericName=Voice Typing
Comment=Private, local dictation for COSMIC
Exec=voxtype settings
Icon=audio-input-microphone
Terminal=false
Categories=Utility;Accessibility;
Keywords=voice;typing;dictation;speech;transcription;microphone;
Actions=Toggle;Shortcuts;

[Desktop Action Toggle]
Name=Start or stop dictation
Exec=voxtype-ctl

[Desktop Action Shortcuts]
Name=Customize keyboard shortcut
Exec=voxtype shortcuts
